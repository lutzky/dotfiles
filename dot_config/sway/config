# Read `man 5 sway` for a complete reference.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ~/.local/bin/kitty
set $browser google-chrome --new-window
set $menu j4-dmenu-desktop --dmenu="~/.bin/bemenu" -I --display-binary --term-mode=kitty --term $term

include /etc/sway/config-vars.d/*

default_border pixel 3
gaps inner 10
output * bg ~/.wallpaper fill

exec swayidle -w \
         timeout 300 'swaylock -f' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f'
# hint: Lock screen
bindsym $mod+q exec swaylock -f 
# hint: Screen toggle
bindsym $mod+period exec ~/.bin/screen_toggle ; swaylock -f 

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

# Middle-mouse-button scrolling
# Note: Interferes with bitwig, onshape, and probably others
# input "*" {
#     scroll_method on_button_down
#     scroll_button 274
#     scroll_factor 0.5
# }

### Keyboard configuration
# xkb mode (no Japanese support)
# input "type:keyboard" {
#     xkb_layout "us,il"
#     xkb_options "grp:win_space_toggle,compose:ralt"
# }

# fcitx5 mode
exec_always fcitx5 -d
input "type:keyboard" {
    xkb_layout "us"
    xkb_options "compose:ralt"
}

focus_follows_mouse no

### Key bindings
# hint: Launch terminal
bindsym $mod+Return exec $term
# hint: Launch browser
bindsym $mod+Shift+Return exec $browser

# hint: Kill focused window
bindsym $mod+Shift+q kill 

# hint: Open menu
bindsym $mod+d exec $menu
# hint: Emoji picker
bindsym Ctrl+$mod+space exec ~/.bin/bemoji -n

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

# hint: Reload the configuration file
bindsym $mod+Shift+c reload 

# hint: Toggle dark mode
bindsym $mod+Shift+d exec ~/.bin/dark_mode_toggle

# "Palette" (help for shortcuts) - note, doesn't support modes
# hint: Key bindings cheat sheet
bindsym $mod+Shift+p exec ~/.config/sway/pallete

# Exit sway (logs you out of your Wayland session)
# hint: Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# hint: Toggle sticky
bindsym $mod+Shift+s sticky toggle

# hint: Split horizontal
bindsym $mod+b splith
# hint: Split vertical
bindsym $mod+v splitv

# hint: Stacking layout
bindsym $mod+s layout stacking
# hint: Tabbed layout
bindsym $mod+w layout tabbed
# hint: Toggle split
bindsym $mod+e layout toggle split

# hint: Fullscreen
bindsym $mod+f fullscreen

# hint: Toggle floating
bindsym $mod+Shift+space floating toggle

# hint: Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle 

# hint: Move focus to the parent container
bindsym $mod+a focus parent 

# Sway has a "scratchpad", which is a bag of holding for windows. You can send
# windows there and get them back later. It's a bit like "minimize".

# hint: Move the currently focused window to the scratchpad
bindsym $mod+Shift+minus move scratchpad 

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple scratchpad windows, this command cycles through them.
# hint: Show next scratchpad window or hide
bindsym $mod+minus scratchpad show 

# hint: Restore last notification
bindsym $mod+Shift+n exec makoctl restore 

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10ph

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# hint: Resize mode
bindsym $mod+r mode "resize"

bindsym XF86AudioRaiseVolume exec ~/.bin/volume up
bindsym XF86AudioLowerVolume exec ~/.bin/volume down
bindsym XF86AudioMute exec ~/.bin/volume mute
bindsym XF86AudioMicMute exec ~/.bin/volume mic-mute
bindsym XF86MonBrightnessUp exec ~/.bin/brightness raise
bindsym XF86MonBrightnessDown exec ~/.bin/brightness lower

for_window [class="esphome"] floating enable

# hint: Screenshot
bindsym Print exec grim -g "$(slurp -d)" - | wl-copy

bar {
    swaybar_command waybar
}

exec wlsunset -l 53.2 -L -6.1
exec hash solaar 2>/dev/null && solaar --window=hide --battery-icons=symbolic
exec blueman-applet

# For obs-studio
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway


include /etc/sway/config.d/*

include ~/.config/sway/sway-colors
