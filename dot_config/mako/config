include=~/.config/mako/colors

font=sans-serif 10
layer=overlay
border-radius=10
border-size=2
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/dialog-information.oga

[urgency=low]
default-timeout=10000
on-notify=none

[app-name=kitty]
default-timeout=5000
anchor=bottom-right
icons=0
format=<b> %s</b>\n%b

[app-name=blueman]
default-timeout=5000
anchor=bottom-right
icons=0
format=<b>  %s</b>\n%b

[app-name=osd]
anchor=bottom-center
width=200
height=60
default-timeout=2000
ignore-timeout=1
group-by=app-name
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/audio-volume-change.oga

# Keep this last for priority

[urgency=critical]
default-timeout=0
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/dialog-error.oga
