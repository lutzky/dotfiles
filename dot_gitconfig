[color]
	ui = auto
[user]
	name = Ohad Lutzky
	email = ohad@lutzky.net
[alias]
	gl = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(yellow)%h%C(bold magenta)%d %C(reset)%C(blue)%ar %C(green)%an\n%C(reset)  %s'
	gla = gl --all
	graph = gl

	# From https://jordanelver.co.uk/blog/2020/06/04/fixing-commits-with-git-commit-fixup-and-git-rebase-autosquash/
	fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
	commitall = "!git add . && git commit -v"
	purr = pull --rebase

	check-contains = "!f() { output=$(git cherry -v \"$1\" \"$2\") || exit 1; echo \"$output\" | grep -q \"^\\+\" && echo \"⚠️ Commits in $2 absent from $1:\" && echo \"$output\" | grep \"^\\+\" || echo \"✅ All commits from $2 are contained in $1.\"\n}; f"
[log]
	decorate = true
[rebase]
	autosquash = true
[github]
	user = lutzky
[web]
	browser = google-chrome
[push]
	default = simple
[include]
	path = ~/.config/git/delta # use delta (should only exist if installed)
	path = ~/.config/git/work  # work stuff
	path = ~/.config/git/local # per-machine settings
[init]
	defaultBranch = main

	# workaround for https://github.com/folke/lazy.nvim/issues/2046
	defaultRefFormat = files
[rerere]
	enabled = true
